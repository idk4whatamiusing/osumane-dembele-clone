{
  "name": "ankhi-tribute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "ASSET_PROFILE=owned opennextjs-cloudflare build && npm run assets:worker",
    "start": "next start",
    "preview:worker": "npm run build:worker && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:core": "node scripts/generate-core-assets.mjs",
    "assets:download": "node scripts/download-reference-assets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:worker": "node scripts/prepare-worker-assets.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify": "npm run assets:validate && npm run lint && npm run typecheck && npm test && npm run build && npm run build:worker"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.6",
    "globals": "16.4.0",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "wrangler": "4.139.0"
  },
  "engines": {
    "node": ">=22"
  }
}
